ing Access Crosstab Queries and Pivot Charts is effortless.\n\n```python\n\"\"\"\nExporter module for Mobile Price Intelligence records.\nSaves records to JSON, CSV, and Microsoft Access (.accdb) for historical DoD/WoW/MoM reporting.\n\"\"\"\nimport csv\nimport json\nimport logging\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom typing import Any, Dict, List, Union\n\nfrom config import ACCESS_TABLE_NAME, OUTPUT_ACCESS_PATH\nfrom models import MobilePriceRecord\n\nlogger \u003d logging.getLogger(\"exporter\")\n\n\ndef _to_dict(rec: Union[MobilePriceRecord, Dict[str, Any]]) -\u003e Dict[str, Any]:\n    \"\"\"Normalize Pydantic model or dict to a standard dictionary.\"\"\"\n    if hasattr(rec, \"model_dump\"):\n        return rec.model_dump()\n    return dict(rec)\n\n\ndef save_to_json(records: List[Union[MobilePriceRecord, Dict[str, Any]]], file_path: Path) -\u003e None:\n    \"\"\"Save records to JSON file.\"\"\"\n    data \u003d [_to_dict(rec) for rec in records]\n    with open(file_path, \"w\", encoding\u003d\"utf-8\") as f:\n        json.dump(data, f, indent\u003d2, ensure_ascii\u003dFalse)\n    logger.info(\"Successfully exported %d records to %s\", len(records), file_path)\n\n\ndef save_to_csv(records: List[Union[MobilePriceRecord, Dict[str, Any]]], file_path: Path) -\u003e None:\n    \"\"\"Save records to CSV file.\"\"\"\n    if not records:\n        logger.warning(\"No records to export to CSV.\")\n        return\n\n    fieldnames \u003d [\n        \"brand\",\n        \"model\",\n        \"storage\",\n        \"ram\",\n        \"cores\",\n        \"camera\",\n        \"condition\",\n        \"defects\",\n        \"buyback_price\",\n        \"currency\",\n        \"data_origin\",\n        \"confidence_score\",\n        \"source_url\",\n        \"timestamp\",\n    ]\n\n    with open(file_path, \"w\", encoding\u003d\"utf-8\", newline\u003d\"\") as f:\n        writer \u003d csv.DictWriter(f, fieldnames\u003dfieldnames)\n        writer.wri