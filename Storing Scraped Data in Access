      "text": "To view your **Day-on-Day (DoD)**, **Week-on-Week (WoW)**, and **Month-on-Month (MoM)** comparison reports directly in the browser, you need:\n1. A helper function in `exporter.py` to read historical records from your MS Access database (`mobile_price_history.accdb`), with an automatic fallback to `output.json` if needed.\n2. Two new routes in `app.py` (`/report` to serve the HTML page and `/api/seed-demo-history` so you can optionally generate realistic historical data across past days, weeks, and months to test the comparison matrix immediately).\n3. The `templates/report.html` file featuring interactive tabs (Day-on-Day, Week-on-Week, Month-on-Month), variance calculations ($\\Delta$ ₹ and $\\Delta$ %), a Chart.js trend line chart, and CSV export.\n\n---\n\n### Step 1: Add `load_from_access()` to `exporter.py`\nAppend this function to the bottom of your `exporter.py` file so Flask can read all historical snapshots from MS Access:\n\n```python\ndef load_from_access(\n    db_path: Path \u003d OUTPUT_ACCESS_PATH,\n    table_name: str \u003d ACCESS_TABLE_NAME,\n) -\u003e List[Dict[str, Any]]:\n    \"\"\"\n    Read all historical pricing records from MS Access (.accdb) for DoD, WoW, and MoM reports.\n    \"\"\"\n    if not db_path.exists():\n        return []\n\n    try:\n        import pyodbc\n        conn_str \u003d (\n            r\"DRIVER\u003d{Microsoft Access Driver (*.mdb, *.accdb)};\"\n            f\"DBQ\u003d{str(db_path.resolve())};\"\n        )\n        conn \u003d pyodbc.connect(conn_str, autocommit\u003dTrue)\n        cursor \u003d conn.cursor()\n\n        table_exists \u003d any(\n            row.table_name.lower() \u003d\u003d table_name.lower()\n            for row in cursor.tables(tableType\u003d\"TABLE\")\n        )\n        if not table_exists:\n            cursor.close()\n            conn.close()\n            return []\n\n        cursor.execute(f\"SELECT * FROM [{table_name}] ORDER BY [scraped_at] ASC\")\n        columns \u003d [col[0] for col in cursor.description]\n        records \u003d []\n\n        for row in cursor.fetchall():\n            rec \u003d dict(zip(columns, row))\n            for dt_col in (\"scraped_at\", \"report_date\"):\n                if isinstance(rec.get(dt_col), datetime):\n                    rec[dt_col] \u003d rec[dt_col].isoformat()\n            records.append(rec)\n\n        cursor.close()\n        conn.close()\n        return records\n    except Exception as exc:\n        logger.warning(\"Could not read from MS Access (%s). Falling back to JSON.\", exc)\n        return []\n```\n\n---\n\n### Step 2: Add the `/report` Routes to `app.py`\nAdd the following routes to your `app.py` (make sure `load_from_access` and `save_to_access` are imported from `exporter`, and `OUTPUT_ACCESS_PATH` is imported from `config`):\n\n```python\nfrom datetime import timedelta\nimport random\nfrom config import OUTPUT_ACCESS_PATH\nfrom exporter import load_from_access, save_to_access\n\n\ndef load_history_records() -\u003e List[Dict[str, Any]]:\n    \"\"\"\n    Load historical records from MS Access if available, otherwise normalize records from output.json.\n    \"\"\"\n    access_records \u003d load_from_access(OUTPUT_ACCESS_PATH)\n    if access_records:\n        return access_records\n\n    # Fallback: Enrich records from output.json with report_date, report_week, report_month\n    raw_records \u003d []\n    if OUTPUT_JSON_PATH.exists():\n        with open(OUTPUT_JSON_PATH, encoding\u003d\"utf-8\") as f:\n            raw_records \u003d json.load(f)\n\n    enriched \u003d []\n    for r in raw_records:\n        ts \u003d r.get(\"timestamp\", datetime.now(timezone.utc).isoformat())\n        try:\n            dt \u003d datetime.fromisoformat(str(ts).replace(\"Z\", \"+00:00\")).astimezone().replace(tzinfo\u003dNone)\n        except ValueError:\n            dt \u003d datetime.now()\n\n        iso_yr, iso_wk, _ \u003d dt.isocalendar()\n        cond \u003d str(r.get(\"condition\", \"\"))\n        grade_code \u003d cond.split(\":\")[0].strip() if \":\" in cond else cond[:30]\n\n        item \u003d dict(r)\n        item[\"grade_code\"] \u003d grade_code\n        item[\"scraped_at\"] \u003d dt.isoformat()\n        item[\"report_date\"] \u003d dt.strftime(\"%Y-%m-%d\")\n        item[\"report_week\"] \u003d f\"{iso_yr}-W{iso_wk:02d}\"\n        item[\"report_month\"] \u003d f\"{dt.year}-{dt.month:02d}\"\n        enriched.append(item)\n\n    return enriched\n\n\n@app.route(\"/report\")\ndef comparison_report():\n    \"\"\"Serve the DoD, WoW, and MoM Price Comparison Report page.\"\"\"\n    history_records \u003d load_history_records()\n    db_connected \u003d OUTPUT_ACCESS_PATH.exists()\n    return render_template(\n        \"report.html\",\n        history_records\u003dhistory_records,\n        db_connected\u003ddb_connected,\n        db_path\u003dstr(OUTPUT_ACCESS_PATH.name),\n    )\n\n\n@app.route(\"/api/seed-demo-history\", methods\u003d[\"POST\"])\ndef api_seed_demo_history():\n    \"\"\"\n    Generate realistic historical snapshots (past days, weeks, and months) from current\n    baseline records and store them in MS Access + output_history so DoD/WoW/MoM can be tested immediately.\n    \"\"\"\n    current_records \u003d load_records()\n    if not current_records:\n        return jsonify({\"success\": False, \"error\": \"No baseline records found. Run a scrape first.\"}), 400\n\n    now \u003d datetime.now(timezone.utc)\n    # Offsets in days covering past 3 days, past 3 weeks, and past 3 months\n    day_offsets \u003d [90, 60, 30, 21, 14, 7, 3, 2, 1, 0]\n    seeded_batch: List[Dict[str, Any]] \u003d []\n\n    for idx, days_ago in enumerate(day_offsets):\n        snap_dt \u003d now - timedelta(days\u003ddays_ago)\n        # Simulate slight market depreciation over time (older prices were ~1% to 6% higher)\n        historical_factor \u003d 1.0 + (days_ago * 0.0006)\n\n        for rec in current_records:\n            clone \u003d copy.deepcopy(rec)\n            jitter \u003d random.uniform(-0.008, 0.008) if days_ago \u003e 0 else 0.0\n            base_price \u003d int(rec.get(\"buyback_price\", 0))\n            clone[\"buyback_price\"] \u003d int(round(base_price * (historical_factor + jitter), -1))\n            clone[\"timestamp\"] \u003d snap_dt.isoformat()\n            seeded_batch.append(clone)\n\n    # Save to MS Access\n    saved_access \u003d save_to_access(seeded_batch, OUTPUT_ACCESS_PATH)\n    # Also append to output.json so JSON fallback works if Access driver isn\u0027t installed\n    save_to_json(seeded_batch, OUTPUT_JSON_PATH)\n\n    return jsonify({\n        \"success\": True,\n        \"access_saved\": saved_access,\n        \"message\": f\"Seeded {len(seeded_batch)} historical records across {len(day_offsets)} time periods!\",\n    })\n```\n\n---\n\n### Step 3: Create `templates/report.html`\nCreate a file named `report.html` inside your `templates/` folder (`templates/report.html`):\n\n```html\n\u003c!DOCTYPE html\u003e\n\u003chtml lang\u003d\"en\"\u003e\n\u003chead\u003e\n  \u003cmeta charset\u003d\"UTF-8\" /\u003e\n  \u003cmeta name\u003d\"viewport\" content\u003d\"width\u003ddevice-width, initial-scale\u003d1.0\" /\u003e\n  \u003ctitle\u003eDoD / WoW / MoM Price Comparison Report — Mobile Price Intelligence\u003c/title\u003e\n  \u003cscript src\u003d\"https://cdn.tailwindcss.com\"\u003e\u003c/script\u003e\n  \u003cscript src\u003d\"https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js\"\u003e\u003c/script\u003e\n  \u003clink href\u003d\"https://fonts.googleapis.com/css2?family\u003dInter:wght@400;500;600;700\u0026display\u003dswap\" rel\u003d\"stylesheet\" /\u003e\n  \u003cstyle\u003e\n    body { font-family: \u0027Inter\u0027, sans-serif; background-color: #0f172a; color: #f8fafc; }\n    .glass-card { background: rgba(30, 41, 59, 0.85); backdrop-filter: blur(10px); border: 1px solid rgba(148, 163, 184, 0.15); }\n    .tab-active { background: linear-gradient(135deg, #3b82f6, #2563eb); color: #fff; box-shadow: 0 4px 12px rgba(37, 99, 235, 0.35); }\n    .tab-inactive { background: rgba(51, 65, 85, 0.5); color: #cbd5e1; }\n    .tab-inactive:hover { background: rgba(71, 85, 105, 0.7); }\n    ::-webkit-scrollbar { width: 8px; height: 8px; }\n    ::-webkit-scrollbar-track { background: #1e293b; }\n    ::-webkit-scrollbar-thumb { background: #475569; border-radius: 4px; }\n  \u003c/style\u003e\n\u003c/head\u003e\n\u003cbody class\u003d\"min-h-screen pb-16\"\u003e\n\n  \u003c!-- Top Navigation Header --\u003e\n  \u003cheader class\u003d\"border-b border-slate-800 bg-slate-900/90 sticky top-0 z-30 backdrop-blur\"\u003e\n    \u003cdiv class\u003d\"max-w-7xl mx-auto px-4 sm:px-6 py-4 flex flex-wrap items-center justify-between gap-4\"\u003e\n      \u003cdiv class\u003d\"flex items-center gap-3\"\u003e\n        \u003cdiv class\u003d\"h-10 w-10 rounded-xl bg-blue-600/20 border border-blue-500/40 flex items-center justify-center text-blue-400 font-bold text-lg\"\u003e\n          📊\n        \u003c/div\u003e\n        \u003cdiv\u003e\n          \u003ch1 class\u003d\"text-lg sm:text-xl font-bold text-white tracking-tight\"\u003e\n            Historical Price Comparison Report (DoD / WoW / MoM)\n          \u003c/h1\u003e\n          \u003cp class\u003d\"text-xs text-slate-400 flex items-center gap-2\"\u003e\n            \u003cspan\u003eSource: \u003cstrong\u003e{{ db_path }}\u003c/strong\u003e\u003c/span\u003e\n            {% if db_connected %}\n              \u003cspan class\u003d\"inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-medium bg-emerald-500/20 text-emerald-300 border border-emerald-500/30\"\u003e\n                ● MS Access Connected\n              \u003c/span\u003e\n            {% else %}\n              \u003cspan class\u003d\"inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-medium bg-amber-500/20 text-amber-300 border border-amber-500/30\"\u003e\n                ● Using JSON Snapshot Fallback\n              \u003c/span\u003e\n            {% endif %}\n          \u003c/p\u003e\n        \u003c/div\u003e\n      \u003c/div\u003e\n\n      \u003cdiv class\u003d\"flex items-center gap-2.5\"\u003e\n        \u003ca href\u003d\"/\" class\u003d\"px-3.5 py-2 rounded-lg text-xs font-medium bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 transition\"\u003e\n          ← Back to Live Scraper\n        \u003c/a\u003e\n        \u003cbutton id\u003d\"btnSeedHistory\" onclick\u003d\"seedDemoHistory()\" class\u003d\"px-3.5 py-2 rounded-lg text-xs font-medium bg-indigo-600/90 hover:bg-indigo-500 text-white border border-indigo-400/30 transition\"\u003e\n          ⚡ Generate Sample Historical Data\n        \u003c/button\u003e\n        \u003cbutton onclick\u003d\"exportComparisonCSV()\" class\u003d\"px-3.5 py-2 rounded-lg text-xs font-medium bg-emerald-600/90 hover:bg-emerald-500 text-white border border-emerald-400/30 transition\"\u003e\n          ⬇ Export Matrix CSV\n        \u003c/button\u003e\n        {% if db_connected %}\n        \u003ca href\u003d\"/download/access\" class\u003d\"px-3.5 py-2 rounded-lg text-xs font-medium bg-blue-600/90 hover:bg-blue-500 text-white border border-blue-400/30 transition\"\u003e\n          🗄 Download .accdb\n        \u003c/a\u003e\n        {% endif %}\n      \u003c/div\u003e\n    \u003c/div\u003e\n  \u003c/header\u003e\n\n  \u003cmain class\u003d\"max-w-7xl mx-auto px-4 sm:px-6 mt-6 space-y-6\"\u003e\n\n    \u003c!-- Control Bar: Period Mode + Filters --\u003e\n    \u003csection class\u003d\"glass-card rounded-2xl p-5\"\u003e\n      \u003cdiv class\u003d\"flex flex-col lg:flex-row lg:items-center justify-between gap-4\"\u003e\n\n        \u003c!-- Period Granularity Tabs --\u003e\n        \u003cdiv\u003e\n          \u003clabel class\u003d\"block text-xs uppercase tracking-wider text-slate-400 font-semibold mb-2\"\u003e\n            Comparison Timeframe\n          \u003c/label\u003e\n          \u003cdiv class\u003d\"inline-flex rounded-xl p-1 bg-slate-900/90 border border-slate-800 gap-1\"\u003e\n            \u003cbutton id\u003d\"tab-day\" onclick\u003d\"setGranularity(\u0027day\u0027)\" class\u003d\"px-4 py-2 rounded-lg text-xs font-semibold transition tab-active\"\u003e\n              📅 Day-on-Day (DoD)\n            \u003c/button\u003e\n            \u003cbutton id\u003d\"tab-week\" onclick\u003d\"setGranularity(\u0027week\u0027)\" class\u003d\"px-4 py-2 rounded-lg text-xs font-semibold transition tab-inactive\"\u003e\n              📆 Week-on-Week (WoW)\n            \u003c/button\u003e\n            \u003cbutton id\u003d\"tab-month\" onclick\u003d\"setGranularity(\u0027month\u0027)\" class\u003d\"px-4 py-2 rounded-lg text-xs font-semibold transition tab-inactive\"\u003e\n              🗓 Month-on-Month (MoM)\n            \u003c/button\u003e\n          \u003c/div\u003e\n        \u003c/div\u003e\n\n        \u003c!-- Filters --\u003e\n        \u003cdiv class\u003d\"grid grid-cols-1 sm:grid-cols-4 gap-3 flex-1 max-w-3xl\"\u003e\n          \u003cdiv\u003e\n            \u003clabel class\u003d\"block text-xs text-slate-400 mb-1\"\u003eSearch Model\u003c/label\u003e\n            \u003cinput id\u003d\"filterSearch\" type\u003d\"text\" oninput\u003d\"renderReport()\" placeholder\u003d\"e.g. iPhone 13, S23...\"\n              class\u003d\"w-full px-3 py-2 rounded-lg bg-slate-900 border border-slate-700 text-xs text-white focus:outline-none focus:border-blue-500\" /\u003e\n          \u003c/div\u003e\n\n          \u003cdiv\u003e\n            \u003clabel class\u003d\"block text-xs text-slate-400 mb-1\"\u003eBrand\u003c/label\u003e\n            \u003cselect id\u003d\"filterBrand\" onchange\u003d\"renderReport()\"\n              class\u003d\"w-full px-3 py-2 rounded-lg bg-slate-900 border border-slate-700 text-xs text-white focus:outline-none focus:border-blue-500\"\u003e\n              \u003coption value\u003d\"ALL\"\u003eAll Brands\u003c/option\u003e\n              \u003coption value\u003d\"Apple\"\u003eApple\u003c/option\u003e\n              \u003coption value\u003d\"Samsung\"\u003eSamsung\u003c/option\u003e\n            \u003c/select\u003e\n          \u003c/div\u003e\n\n          \u003cdiv\u003e\n            \u003clabel class\u003d\"block text-xs text-slate-400 mb-1\"\u003eCondition Grade\u003c/label\u003e\n            \u003cselect id\u003d\"filterGrade\" onchange\u003d\"renderReport()\"\n              class\u003d\"w-full px-3 py-2 rounded-lg bg-slate-900 border border-slate-700 text-xs text-white focus:outline-none focus:border-blue-500\"\u003e\n              \u003coption value\u003d\"Grade A\" selected\u003eGrade A (Verified Baseline)\u003c/option\u003e\n              \u003coption value\u003d\"Grade B\"\u003eGrade B (Good)\u003c/option\u003e\n              \u003coption value\u003d\"Grade C\"\u003eGrade C (Fair)\u003c/option\u003e\n              \u003coption value\u003d\"Grade D\"\u003eGrade D (Defective)\u003c/option\u003e\n              \u003coption value\u003d\"ALL\"\u003eAll Condition Grades\u003c/option\u003e\n            \u003c/select\u003e\n          \u003c/div\u003e\n\n          \u003cdiv\u003e\n            \u003clabel class\u003d\"block text-xs text-slate-400 mb-1\"\u003eStorage\u003c/label\u003e\n            \u003cselect id\u003d\"filterStorage\" onchange\u003d\"renderReport()\"\n              class\u003d\"w-full px-3 py-2 rounded-lg bg-slate-900 border border-slate-700 text-xs text-white focus:outline-none focus:border-blue-500\"\u003e\n              \u003coption value\u003d\"ALL\"\u003eAll Capacities\u003c/option\u003e\n              \u003coption value\u003d\"64 GB\"\u003e64 GB\u003c/option\u003e\n              \u003coption value\u003d\"128 GB\"\u003e128 GB\u003c/option\u003e\n              \u003coption value\u003d\"256 GB\"\u003e256 GB\u003c/option\u003e\n              \u003coption value\u003d\"512 GB\"\u003e512 GB\u003c/option\u003e\n            \u003c/select\u003e\n          \u003c/div\u003e\n        \u003c/div\u003e\n\n      \u003c/div\u003e\n    \u003c/section\u003e\n\n    \u003c!-- Summary KPI Cards --\u003e\n    \u003csection class\u003d\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4\"\u003e\n      \u003cdiv class\u003d\"glass-card rounded-xl p-4\"\u003e\n        \u003cspan class\u003d\"text-xs text-slate-400\"\u003eTracked Period Buckets\u003c/span\u003e\n        \u003cdiv id\u003d\"kpiPeriods\" class\u003d\"text-2xl font-bold text-white mt-1\"\u003e0\u003c/div\u003e\n        \u003cspan id\u003d\"kpiPeriodRange\" class\u003d\"text-[11px] text-slate-400\"\u003e—\u003c/span\u003e\n      \u003c/div\u003e\n\n      \u003cdiv class\u003d\"glass-card rounded-xl p-4\"\u003e\n        \u003cspan class\u003d\"text-xs text-slate-400\"\u003eLatest Avg Buyback Price\u003c/span\u003e\n        \u003cdiv id\u003d\"kpiLatestAvg\" class\u003d\"text-2xl font-bold text-blue-400 mt-1\"\u003e₹0\u003c/div\u003e\n        \u003cspan class\u003d\"text-[11px] text-slate-400\"\u003eAcross filtered devices\u003c/span\u003e\n      \u003c/div\u003e\n\n      \u003cdiv class\u003d\"glass-card rounded-xl p-4\"\u003e\n        \u003cspan class\u003d\"text-xs text-slate-400\"\u003eAvg Period-over-Period Change\u003c/span\u003e\n        \u003cdiv id\u003d\"kpiAvgDelta\" class\u003d\"text-2xl font-bold text-emerald-400 mt-1\"\u003e0.0%\u003c/div\u003e\n        \u003cspan id\u003d\"kpiDeltaLabel\" class\u003d\"text-[11px] text-slate-400\"\u003eLatest vs Previous Period\u003c/span\u003e\n      \u003c/div\u003e\n\n      \u003cdiv class\u003d\"glass-card rounded-xl p-4\"\u003e\n        \u003cspan class\u003d\"text-xs text-slate-400\"\u003eBiggest Price Mover\u003c/span\u003e\n        \u003cdiv id\u003d\"kpiTopMover\" class\u003d\"text-base font-bold text-amber-300 mt-1 truncate\"\u003eN/A\u003c/div\u003e\n        \u003cspan id\u003d\"kpiTopMoverSub\" class\u003d\"text-[11px] text-slate-400\"\u003e—\u003c/span\u003e\n      \u003c/div\u003e\n    \u003c/section\u003e\n\n    \u003c!-- Historical Trend Line Chart --\u003e\n    \u003csection class\u003d\"glass-card rounded-2xl p-5\"\u003e\n      \u003cdiv class\u003d\"flex items-center justify-between mb-4\"\u003e\n        \u003cdiv\u003e\n          \u003ch2 class\u003d\"text-sm font-bold text-white uppercase tracking-wider\" id\u003d\"chartTitle\"\u003e\n            Historical Price Trend\n          \u003c/h2\u003e\n          \u003cp class\u003d\"text-xs text-slate-400\"\u003e\n            Visualizes buyback price movements across selected time buckets (top 6 matching variants)\n          \u003c/p\u003e\n        \u003c/div\u003e\n      \u003c/div\u003e\n      \u003cdiv class\u003d\"h-72 w-full\"\u003e\n        \u003ccanvas id\u003d\"trendChart\"\u003e\u003c/canvas\u003e\n      \u003c/div\u003e\n    \u003c/section\u003e\n\n    \u003c!-- Crosstab Comparison Matrix Table --\u003e\n    \u003csection class\u003d\"glass-card rounded-2xl overflow-hidden\"\u003e\n      \u003cdiv class\u003d\"px-5 py-4 border-b border-slate-800 flex flex-wrap items-center justify-between gap-2\"\u003e\n        \u003cdiv\u003e\n          \u003ch2 class\u003d\"text-sm font-bold text-white uppercase tracking-wider\" id\u003d\"matrixTitle\"\u003e\n            Day-on-Day (DoD) Price Comparison Matrix\n          \u003c/h2\u003e\n          \u003cp class\u003d\"text-xs text-slate-400\"\u003e\n            Compares each period\u0027s average buyback quote and highlights Latest vs. Previous variance (Δ ₹ and Δ %)\n          \u003c/p\u003e\n        \u003c/div\u003e\n        \u003cspan id\u003d\"rowCountBadge\" class\u003d\"px-2.5 py-1 rounded-full text-xs font-medium bg-slate-800 text-slate-300\"\u003e\n          0 variants\n        \u003c/span\u003e\n      \u003c/div\u003e\n\n      \u003cdiv class\u003d\"overflow-x-auto\"\u003e\n        \u003ctable class\u003d\"w-full text-left border-collapse\"\u003e\n          \u003cthead id\u003d\"matrixThead\" class\u003d\"bg-slate-900/90 text-[11px] uppercase tracking-wider text-slate-400 border-b border-slate-800\"\u003e\n          \u003c/thead\u003e\n          \u003ctbody id\u003d\"matrixTbody\" class\u003d\"divide-y divide-slate-800/70 text-xs\"\u003e\n          \u003c/tbody\u003e\n        \u003c/table\u003e\n      \u003c/div\u003e\n    \u003c/section\u003e\n\n  \u003c/main\u003e\n\n  \u003cscript\u003e\n    // Injected historical records from Flask backend\n    const RAW_HISTORY \u003d {{ history_records | tojson | safe }};\n    let currentGranularity \u003d \u0027day\u0027; // \u0027day\u0027 | \u0027week\u0027 | \u0027month\u0027\n    let trendChartInstance \u003d null;\n    let latestExportRows \u003d [];\n\n    function getBucketKey(record, mode) {\n      const rawTs \u003d record.scraped_at || record.timestamp || \u0027\u0027;\n      const d \u003d rawTs ? new Date(rawTs) : new Date();\n      if (isNaN(d.getTime())) return \u0027Unknown\u0027;\n\n      if (mode \u003d\u003d\u003d \u0027day\u0027) {\n        if (record.report_date \u0026\u0026 record.report_date.length \u003e\u003d 10) {\n          return record.report_date.substring(0, 10);\n        }\n        return d.toISOString().substring(0, 10);\n      }\n\n      if (mode \u003d\u003d\u003d \u0027week\u0027) {\n        if (record.report_week) return record.report_week;\n        // Compute ISO week\n        const temp \u003d new Date(Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()));\n        const dayNum \u003d temp.getUTCDay() || 7;\n        temp.setUTCDate(temp.getUTCDate() + 4 - dayNum);\n        const yearStart \u003d new Date(Date.UTC(temp.getUTCFullYear(), 0, 1));\n        const weekNo \u003d Math.ceil((((temp - yearStart) / 86400000) + 1) / 7);\n        return `${temp.getUTCFullYear()}-W${String(weekNo).padStart(2, \u00270\u0027)}`;\n      }\n\n      if (mode \u003d\u003d\u003d \u0027month\u0027) {\n        if (record.report_month) return record.report_month;\n        return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, \u00270\u0027)}`;\n      }\n      return \u0027Unknown\u0027;\n    }\n\n    function getGradeShort(record) {\n      const g \u003d record.grade_code || record.condition || \u0027\u0027;\n      if (g.includes(\u0027Grade A\u0027)) return \u0027Grade A\u0027;\n      if (g.includes(\u0027Grade B\u0027)) return \u0027Grade B\u0027;\n      if (g.includes(\u0027Grade C\u0027)) return \u0027Grade C\u0027;\n      if (g.includes(\u0027Grade D\u0027)) return \u0027Grade D\u0027;\n      return g.split(\u0027:\u0027)[0].trim() || \u0027Grade A\u0027;\n    }\n\n    function setGranularity(mode) {\n      currentGranularity \u003d mode;\n      [\u0027day\u0027, \u0027week\u0027, \u0027month\u0027].forEach(m \u003d\u003e {\n        const btn \u003d document.getElementById(`tab-${m}`);\n        btn.className \u003d (m \u003d\u003d\u003d mode)\n          ? \u0027px-4 py-2 rounded-lg text-xs font-semibold transition tab-active\u0027\n          : \u0027px-4 py-2 rounded-lg text-xs font-semibold transition tab-inactive\u0027;\n      });\n\n      const titles \u003d {\n        day: \u0027Day-on-Day (DoD) Price Comparison Matrix\u0027,\n        week: \u0027Week-on-Week (WoW) Price Comparison Matrix\u0027,\n        month: \u0027Month-on-Month (MoM) Price Comparison Matrix\u0027\n      };\n      document.getElementById(\u0027matrixTitle\u0027).textContent \u003d titles[mode];\n      renderReport();\n    }\n\n    function formatINR(val) {\n      if (val \u003d\u003d\u003d null || val \u003d\u003d\u003d undefined || isNaN(val)) return \u0027—\u0027;\n      return \u0027₹\u0027 + Math.round(val).toLocaleString(\u0027en-IN\u0027);\n    }\n\n    function renderReport() {\n      const searchVal \u003d document.getElementById(\u0027filterSearch\u0027).value.trim().toLowerCase();\n      const brandVal \u003d document.getElementById(\u0027filterBrand\u0027).value;\n      const gradeVal \u003d document.getElementById(\u0027filterGrade\u0027).value;\n      const storageVal \u003d document.getElementById(\u0027filterStorage\u0027).value;\n\n      // 1. Filter records\n      const filtered \u003d RAW_HISTORY.filter(r \u003d\u003e {\n        const brand \u003d (r.brand || \u0027\u0027).trim();\n        const model \u003d (r.model || \u0027\u0027).toLowerCase();\n        const storage \u003d (r.storage || \u0027\u0027).trim();\n        const grade \u003d getGradeShort(r);\n\n        if (brandVal !\u003d\u003d \u0027ALL\u0027 \u0026\u0026 brand.toLowerCase() !\u003d\u003d brandVal.toLowerCase()) return false;\n        if (gradeVal !\u003d\u003d \u0027ALL\u0027 \u0026\u0026 grade !\u003d\u003d gradeVal) return false;\n        if (storageVal !\u003d\u003d \u0027ALL\u0027 \u0026\u0026 storage.toUpperCase() !\u003d\u003d storageVal.toUpperCase()) return false;\n        if (searchVal \u0026\u0026 !model.includes(searchVal) \u0026\u0026 !brand.toLowerCase().includes(searchVal)) return false;\n        return true;\n      });\n\n      // 2. Collect sorted unique period buckets\n      const periodSet \u003d new Set();\n      const deviceGroups \u003d {};\n\n      filtered.forEach(r \u003d\u003e {\n        const period \u003d getBucketKey(r, currentGranularity);\n        periodSet.add(period);\n\n        const grade \u003d getGradeShort(r);\n        const key \u003d `${r.brand}||${r.model}||${r.storage}||${grade}`;\n        if (!deviceGroups[key]) {\n          deviceGroups[key] \u003d {\n            brand: r.brand,\n            model: r.model,\n            storage: r.storage,\n            grade: grade,\n            buckets: {}\n          };\n        }\n        if (!deviceGroups[key].buckets[period]) {\n          deviceGroups[key].buckets[period] \u003d [];\n        }\n        deviceGroups[key].buckets[period].push(Number(r.buyback_price) || 0);\n      });\n\n      const periods \u003d Array.from(periodSet).sort();\n      const displayPeriods \u003d periods.slice(-8); // Show up to last 8 periods cleanly\n\n      // 3. Build table header\n      const thead \u003d document.getElementById(\u0027matrixThead\u0027);\n      let headHTML \u003d `\u003ctr\u003e\n        \u003cth class\u003d\"py-3.5 px-4\"\u003eBrand\u003c/th\u003e\n        \u003cth class\u003d\"py-3.5 px-4\"\u003eModel\u003c/th\u003e\n        \u003cth class\u003d\"py-3.5 px-3\"\u003eStorage\u003c/th\u003e\n        \u003cth class\u003d\"py-3.5 px-3\"\u003eGrade\u003c/th\u003e`;\n\n      displayPeriods.forEach(p \u003d\u003e {\n        headHTML +\u003d `\u003cth class\u003d\"py-3.5 px-3 text-right font-semibold text-slate-300\"\u003e${p}\u003c/th\u003e`;\n      });\n\n      headHTML +\u003d `\n        \u003cth class\u003d\"py-3.5 px-4 text-right text-blue-300\"\u003eΔ Price (INR)\u003c/th\u003e\n        \u003cth class\u003d\"py-3.5 px-4 text-right text-blue-300\"\u003eΔ Change (%)\u003c/th\u003e\n        \u003cth class\u003d\"py-3.5 px-4 text-right text-slate-300\"\u003eOverall Δ (First→Last)\u003c/th\u003e\n      \u003c/tr\u003e`;\n      thead.innerHTML \u003d headHTML;\n\n      // 4. Build rows \u0026 compute KPIs\n      const tbody \u003d document.getElementById(\u0027matrixTbody\u0027);\n      const rows \u003d Object.values(deviceGroups).sort((a, b) \u003d\u003e a.model.localeCompare(b.model));\n      document.getElementById(\u0027rowCountBadge\u0027).textContent \u003d `${rows.length} variants`;\n\n      let latestPrices \u003d [];\n      let popChangesPct \u003d [];\n      let topMover \u003d { name: \u0027N/A\u0027, pct: 0, diff: 0 };\n      latestExportRows \u003d [];\n\n      if (rows.length \u003d\u003d\u003d 0) {\n        tbody.innerHTML \u003d `\u003ctr\u003e\n          \u003ctd colspan\u003d\"${displayPeriods.length + 7}\" class\u003d\"py-12 text-center text-slate-400\"\u003e\n            No matching historical records found. Click \u003cstrong\u003e\"⚡ Generate Sample Historical Data\"\u003c/strong\u003e above or run a scrape first.\n          \u003c/td\u003e\n        \u003c/tr\u003e`;\n      } else {\n        let bodyHTML \u003d \u0027\u0027;\n\n        rows.forEach(item \u003d\u003e {\n          // Compute average per period\n          const avgByPeriod \u003d {};\n          displayPeriods.forEach(p \u003d\u003e {\n            const arr \u003d item.buckets[p];\n            if (arr \u0026\u0026 arr.length \u003e 0) {\n              avgByPeriod[p] \u003d arr.reduce((a, b) \u003d\u003e a + b, 0) / arr.length;\n            } else {\n              avgByPeriod[p] \u003d null;\n            }\n          });\n\n          // Find non-null periods for this row\n          const validPeriods \u003d displayPeriods.filter(p \u003d\u003e avgByPeriod[p] !\u003d\u003d null);\n          const latestVal \u003d validPeriods.length \u003e\u003d 1 ? avgByPeriod[validPeriods[validPeriods.length - 1]] : null;\n          const prevVal \u003d validPeriods.length \u003e\u003d 2 ? avgByPeriod[validPeriods[validPeriods.length - 2]] : null;\n          const firstVal \u003d validPeriods.length \u003e\u003d 2 ? avgByPeriod[validPeriods[0]] : null;\n\n          if (latestVal !\u003d\u003d null) latestPrices.push(latestVal);\n\n          let diffINR \u003d null;\n          let diffPct \u003d null;\n          if (latestVal !\u003d\u003d null \u0026\u0026 prevVal !\u003d\u003d null \u0026\u0026 prevVal \u003e 0) {\n            diffINR \u003d latestVal - prevVal;\n            diffPct \u003d (diffINR / prevVal) * 100;\n            popChangesPct.push(diffPct);\n\n            if (Math.abs(diffPct) \u003e Math.abs(topMover.pct)) {\n              topMover \u003d { name: `${item.model}`, pct: diffPct, diff: diffINR };\n            }\n          }\n\n          let overallDiffINR \u003d (latestVal !\u003d\u003d null \u0026\u0026 firstVal !\u003d\u003d null) ? (latestVal - firstVal) : null;\n          let overallPct \u003d (overallDiffINR !\u003d\u003d null \u0026\u0026 firstVal \u003e 0) ? ((overallDiffINR / firstVal) * 100) : null;\n\n          // Prepare export row\n          const expObj \u003d {\n            Brand: item.brand,\n            Model: item.model,\n            Storage: item.storage,\n            Grade: item.grade\n          };\n          displayPeriods.forEach(p \u003d\u003e {\n            expObj[p] \u003d avgByPeriod[p] !\u003d\u003d null ? Math.round(avgByPeriod[p]) : \u0027\u0027;\n          });\n          expObj[\u0027Delta_INR\u0027] \u003d diffINR !\u003d\u003d null ? Math.round(diffINR) : \u0027\u0027;\n          expObj[\u0027Delta_Pct\u0027] \u003d diffPct !\u003d\u003d null ? diffPct.toFixed(2) + \u0027%\u0027 : \u0027\u0027;\n          latestExportRows.push(expObj);\n\n          // Format badge styling\n          let deltaBadge \u003d \u0027\u003cspan class\u003d\"text-slate-500\"\u003e—\u003c/span\u003e\u0027;\n          let pctBadge \u003d \u0027\u003cspan class\u003d\"text-slate-500\"\u003e—\u003c/span\u003e\u0027;\n          if (diffINR !\u003d\u003d null) {\n            const sign \u003d diffINR \u003e 0 ? \u0027+\u0027 : \u0027\u0027;\n            const cls \u003d diffINR \u003e 0\n              ? \u0027text-emerald-400 font-semibold\u0027\n              : (diffINR \u003c 0 ? \u0027text-rose-400 font-semibold\u0027 : \u0027text-slate-400\u0027);\n            deltaBadge \u003d `\u003cspan class\u003d\"${cls}\"\u003e${sign}${formatINR(diffINR)}\u003c/span\u003e`;\n            pctBadge \u003d `\u003cspan class\u003d\"px-2 py-0.5 rounded text-[11px] ${\n              diffINR \u003e 0 ? \u0027bg-emerald-500/15 text-emerald-300\u0027 :\n              diffINR \u003c 0 ? \u0027bg-rose-500/15 text-rose-300\u0027 : \u0027bg-slate-800 text-slate-400\u0027\n            }\"\u003e${sign}${diffPct.toFixed(2)}%\u003c/span\u003e`;\n          }\n\n          let overallBadge \u003d \u0027\u003cspan class\u003d\"text-slate-500\"\u003e—\u003c/span\u003e\u0027;\n          if (overallDiffINR !\u003d\u003d null) {\n            const sign \u003d overallDiffINR \u003e 0 ? \u0027+\u0027 : \u0027\u0027;\n            const cls \u003d overallDiffINR \u003e 0 ? \u0027text-emerald-400\u0027 : (overallDiffINR \u003c 0 ? \u0027text-rose-400\u0027 : \u0027text-slate-400\u0027);\n            overallBadge \u003d `\u003cspan class\u003d\"${cls}\"\u003e${sign}${formatINR(overallDiffINR)} (${sign}${overallPct.toFixed(1)}%)\u003c/span\u003e`;\n          }\n\n          bodyHTML +\u003d `\u003ctr class\u003d\"hover:bg-slate-800/40 transition\"\u003e\n            \u003ctd class\u003d\"py-3 px-4 font-medium text-slate-300\"\u003e${item.brand}\u003c/td\u003e\n            \u003ctd class\u003d\"py-3 px-4 font-semibold text-white\"\u003e${item.model}\u003c/td\u003e\n            \u003ctd class\u003d\"py-3 px-3 text-slate-300\"\u003e${item.storage}\u003c/td\u003e\n            \u003ctd class\u003d\"py-3 px-3\"\u003e\n              \u003cspan class\u003d\"px-2 py-0.5 rounded text-[11px] bg-slate-800 text-slate-300 border border-slate-700\"\u003e${item.grade}\u003c/span\u003e\n            \u003c/td\u003e`;\n\n          displayPeriods.forEach(p \u003d\u003e {\n            const v \u003d avgByPeriod[p];\n            bodyHTML +\u003d `\u003ctd class\u003d\"py-3 px-3 text-right font-mono ${v !\u003d\u003d null ? \u0027text-slate-200\u0027 : \u0027text-slate-600\u0027}\"\u003e\n              ${v !\u003d\u003d null ? formatINR(v) : \u0027—\u0027}\n            \u003c/td\u003e`;\n          });\n\n          bodyHTML +\u003d `\n            \u003ctd class\u003d\"py-3 px-4 text-right font-mono\"\u003e${deltaBadge}\u003c/td\u003e\n            \u003ctd class\u003d\"py-3 px-4 text-right font-mono\"\u003e${pctBadge}\u003c/td\u003e\n            \u003ctd class\u003d\"py-3 px-4 text-right font-mono text-[11px]\"\u003e${overallBadge}\u003c/td\u003e\n          \u003c/tr\u003e`;\n        });\n\n        tbody.innerHTML \u003d bodyHTML;\n      }\n\n      // 5. Update KPI summary cards\n      document.getElementById(\u0027kpiPeriods\u0027).textContent \u003d displayPeriods.length;\n      document.getElementById(\u0027kpiPeriodRange\u0027).textContent \u003d displayPeriods.length \u003e 0\n        ? `${displayPeriods[0]} → ${displayPeriods[displayPeriods.length - 1]}`\n        : \u0027No time buckets\u0027;\n\n      const avgLatest \u003d latestPrices.length \u003e 0\n        ? latestPrices.reduce((a, b) \u003d\u003e a + b, 0) / latestPrices.length\n        : 0;\n      document.getElementById(\u0027kpiLatestAvg\u0027).textContent \u003d formatINR(avgLatest);\n\n      const avgPop \u003d popChangesPct.length \u003e 0\n        ? popChangesPct.reduce((a, b) \u003d\u003e a + b, 0) / popChangesPct.length\n        : 0;\n      const deltaEl \u003d document.getElementById(\u0027kpiAvgDelta\u0027);\n      deltaEl.textContent \u003d `${avgPop \u003e 0 ? \u0027+\u0027 : \u0027\u0027}${avgPop.toFixed(2)}%`;\n      deltaEl.className \u003d `text-2xl font-bold mt-1 ${\n        avgPop \u003e 0 ? \u0027text-emerald-400\u0027 : (avgPop \u003c 0 ? \u0027text-rose-400\u0027 : \u0027text-slate-300\u0027)\n      }`;\n\n      document.getElementById(\u0027kpiTopMover\u0027).textContent \u003d topMover.name;\n      document.getElementById(\u0027kpiTopMoverSub\u0027).textContent \u003d topMover.name !\u003d\u003d \u0027N/A\u0027\n        ? `${topMover.diff \u003e 0 ? \u0027+\u0027 : \u0027\u0027}${formatINR(topMover.diff)} (${topMover.pct \u003e 0 ? \u0027+\u0027 : \u0027\u0027}${topMover.pct.toFixed(2)}%)`\n        : \u0027Need at least 2 time periods\u0027;\n\n      // 6. Update Chart.js visualization\n      updateTrendChart(displayPeriods, rows.slice(0, 6));\n    }\n\n    function updateTrendChart(periods, topRows) {\n      const ctx \u003d document.getElementById(\u0027trendChart\u0027).getContext(\u00272d\u0027);\n      if (trendChartInstance) {\n        trendChartInstance.destroy();\n      }\n\n      const palette \u003d [\u0027#3b82f6\u0027, \u0027#10b981\u0027, \u0027#f59e0b\u0027, \u0027#ec4899\u0027, \u0027#8b5cf6\u0027, \u0027#06b6d4\u0027];\n      const datasets \u003d topRows.map((row, idx) \u003d\u003e {\n        const dataPts \u003d periods.map(p \u003d\u003e {\n          const arr \u003d row.buckets[p];\n          return (arr \u0026\u0026 arr.length \u003e 0)\n            ? Math.round(arr.reduce((a, b) \u003d\u003e a + b, 0) / arr.length)\n            : null;\n        });\n\n        return {\n          label: `${row.model} (${row.grade})`,\n          data: dataPts,\n          borderColor: palette[idx % palette.length],\n          backgroundColor: palette[idx % palette.length] + \u002733\u0027,\n          borderWidth: 2.5,\n          tension: 0.3,\n          spanGaps: true,\n          pointRadius: 4\n        };\n      });\n\n      trendChartInstance \u003d new Chart(ctx, {\n        type: \u0027line\u0027,\n        data: { labels: periods, datasets },\n        options: {\n          responsive: true,\n          maintainAspectRatio: false,\n          interaction: { mode: \u0027index\u0027, intersect: false },\n          plugins: {\n            legend: {\n              labels: { color: \u0027#cbd5e1\u0027, font: { size: 11 } }\n            },\n            tooltip: {\n              callbacks: {\n                label: (ctx) \u003d\u003e `${ctx.dataset.label}: ₹${(ctx.parsed.y || 0).toLocaleString(\u0027en-IN\u0027)}`\n              }\n            }\n          },\n          scales: {\n            x: {\n              ticks: { color: \u0027#94a3b8\u0027, font: { size: 11 } },\n              grid: { color: \u0027rgba(148, 163, 184, 0.08)\u0027 }\n            },\n            y: {\n              ticks: {\n                color: \u0027#94a3b8\u0027,\n                font: { size: 11 },\n                callback: (v) \u003d\u003e \u0027₹\u0027 + v.toLocaleString(\u0027en-IN\u0027)\n              },\n              grid: { color: \u0027rgba(148, 163, 184, 0.08)\u0027 }\n            }\n          }\n        }\n      });\n    }\n\n    async function seedDemoHistory() {\n      const btn \u003d document.getElementById(\u0027btnSeedHistory\u0027);\n      const origText \u003d btn.innerHTML;\n      btn.disabled \u003d true;\n      btn.innerHTML \u003d \u0027⏳ Seeding History...\u0027;\n\n      try {\n        const res \u003d await fetch(\u0027/api/seed-demo-history\u0027, { method: \u0027POST\u0027 });\n        const data \u003d await res.json();\n        if (data.success) {\n          window.location.reload();\n        } else {\n          alert(data.error || \u0027Failed to seed history\u0027);\n          btn.disabled \u003d false;\n          btn.innerHTML \u003d origText;\n        }\n      } catch (err) {\n        alert(\u0027Error seeding history: \u0027 + err);\n        btn.disabled \u003d false;\n        btn.innerHTML \u003d origText;\n      }\n    }\n\n    function exportComparisonCSV() {\n      if (!latestExportRows.length) {\n        alert(\u0027No rows to export.\u0027);\n        return;\n      }\n      const headers \u003d Object.keys(latestExportRows[0]);\n      const csvLines \u003d [\n        headers.join(\u0027,\u0027),\n        ...latestExportRows.map(row \u003d\u003e\n          headers.map(h \u003d\u003e `\"${String(row[h] ?? \u0027\u0027).replace(/\"/g, \u0027\"\"\u0027)}\"`).join(\u0027,\u0027)\n        )\n      ];\n      const blob \u003d new Blob([csvLines.join(\u0027\\n\u0027)], { type: \u0027text/csv;charset\u003dutf-8;\u0027 });\n      const url \u003d URL.createObjectURL(blob);\n      const a \u003d document.createElement(\u0027a\u0027);\n      a.href \u003d url;\n      a.download \u003d `price_comparison_${currentGranularity}_${new Date().toISOString().slice(0,10)}.csv`;\n      a.click();\n      URL.revokeObjectURL(url);\n    }\n\n    // Initialize on load\n    document.addEventListener(\u0027DOMContentLoaded\u0027, () \u003d\u003e {\n      renderReport();\n    });\n  \u003c/script\u003e\n\u003c/body\u003e\n\u003c/html\u003e\n```\n\n---\n\n### Step 4: How to Access \u0026 Use the Comparison Report\n1. Start your Flask web server:\n   ```powershell\n   python app.py\n   ```\n2. Open **`http://127.0.0.1:5000/report`** in your browser (you can also add a link `\u003ca href\u003d\"/report\"\u003e📊 Historical Comparison Report\u003c/a\u003e` to your main `templates/index.html` navbar).\n3. If you have only scraped once today and want to immediately test h