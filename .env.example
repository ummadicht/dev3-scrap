# ==============================================================================
# Mobile Price Intelligence - Environment Configuration
# ==============================================================================

# --- Database Connection ---
# Option 1: Full Database Connection URL (Recommended for Docker / Production)
DATABASE_URL=postgresql://devuser:StrongDevPassword123!@host.docker.internal:5432/swapup_dev

# Option 2: Individual DB Parameters (Fallback if DATABASE_URL is not set)
DB_DIALECT=postgresql       # postgresql or mysql
DB_HOST=127.0.0.1
DB_PORT=5432                # 5432 for Postgres, 3306 for MySQL
DB_NAME=swapup_dev
DB_USERNAME=devuser
DB_PASSWORD=StrongDevPassword123!
DB_SCHEMA=public

# --- Optional SSH Tunnel (Only for remote bastion connection if needed) ---
# USE_SSH_TUNNEL=false
# SSH_HOST=
# SSH_PORT=22
# SSH_USERNAME=
# SSH_PRIVATE_KEY_PATH=./proxy.pem

# --- WholeCellMarket / PriceIQ API Integration ---
PRICEIQ_TOKEN_URL=https://wholecellmarket.com/apps/priceiq/api/oauth/token
PRICEIQ_BULK_URL=https://wholecellmarket.com/apps/priceiq/api/prices/bulk
WHOLECELL_CLIENT_ID=
WHOLECELL_CLIENT_SECRET=
