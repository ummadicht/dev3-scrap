# PostgreSQL
DATABASE_URL=postgresql+psycopg://scraper:scraper_password@localhost:5432/phone_prices
POSTGRES_DB=phone_prices
POSTGRES_USER=scraper
POSTGRES_PASSWORD=scraper_password

# Scraping behavior
RESPECT_ROBOTS_TXT=true
RATE_LIMIT_MIN_SEC=1.0
RATE_LIMIT_MAX_SEC=3.0
MAX_CONCURRENCY_PER_DOMAIN=2
HTTP_TIMEOUT_SEC=20.0
MAX_RETRIES=3
RAW_CACHE_DIR=raw
EXPORTS_DIR=exports
USE_RAW_CACHE=false
PROXY_LIST=

# Scheduler (24h UTC HH:MM)
SCHEDULE_CRON_TIME=02:00
SCHEDULE_TIMEZONE=UTC

# Optional S3-compatible export upload (AWS S3, MinIO, Cloudflare R2)
S3_ENABLED=false
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=

# Generic API secrets referenced by name in config/sources/*.yaml
EXAMPLE_API_BEARER_TOKEN=
PARTNER_OAUTH_CLIENT_ID=
PARTNER_OAUTH_CLIENT_SECRET=
PARTNER_API_KEY=
